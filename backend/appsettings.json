{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Polly": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "dZENcode.Forumish"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "var/log/forumish-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379,connectTimeout=3000,syncTimeout=1000,asyncTimeout=1000"
  },
  "RateLimiting": {
    "Captcha": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Captcha": {
    "General": {
      "IdLength": 36,
      "CodeLength": 5
    },
    "Storage": {
      "EntryPrefix": "captcha",
      "EntryExpirationSeconds": 120
    },
    "Visuals": {
      "MaximumWidth": 400,
      "MaximumHeight": 200
    },
    "Concerns": {
      "IdHeader": "X-Captcha-Id",
      "CodeHeader": "X-Captcha-Code"
    }
  }
}