{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Polly": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "dZENcode.Forumish"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "var/log/forumish-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=Forumish;Integrated Security=True;TrustServerCertificate=True",
    "Redis": "localhost:6379,connectTimeout=3000,syncTimeout=1000,asyncTimeout=1000"
  },
  "RateLimiting": {
    "Captcha": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "Captcha": {
    "General": {
      "IdLength": 36,
      "CodeLength": 5
    },
    "Storage": {
      "EntryPrefix": "captcha",
      "EntryExpirationSeconds": 120
    },
    "Visuals": {
      "MaximumWidth": 400,
      "MaximumHeight": 200
    },
    "Concerns": {
      "IdHeader": "X-Captcha-Id",
      "CodeHeader": "X-Captcha-Code"
    }
  },
  "User": {
    "Domain": {
      "Length": 32
    }
  },
  "Comment": {
    "Identity": {
      "FingerprintMaximumLength": 256
    },
    "Domain": {
      "EmailMaximumLength": 254,
      "UsernameMinimumLength": 3,
      "UsernameMaximumLength": 64,
      "HomePageMaximumLength": 2048,
      "MessageMaximumLength": 4096
    },
    "MessageSanitizer": {
      "AllowedTags": [
        "a",
        "code",
        "i",
        "strong"
      ],
      "AllowedAttributes": [
        "href",
        "title"
      ],
      "UriAttributes": [
        "href"
      ],
      "AllowedSchemes": [
        "http",
        "https"
      ]
    }
  },
  "Attachment": {
    "Processing": {
      "Recovery": {
        "IntervalSeconds": 60,
        "PendingAgeSeconds": 120
      }
    },
    "Mime": {
      "image/jpeg": 10485760,
      "image/png": 10485760,
      "image/gif": 10485760,
      "text/plain": 102400
    },
    "Domain": {
      "FiletypeMaximumLength": 255,
      "FilepathMaximumLength": 255
    },
    "Storage": {
      "BufferSize": 81920,
      "PublicPath": "www/attachments/public",
      "StagingPath": "www/attachments/staging"
    },
    "Image": {
      "Processing": {
        "MaximumWidth": 320,
        "MaximumHeight": 240,
        "MaximumSourcePixels": 40000000,
        "MaximumFrames": 100,
        "JpegQuality": 85
      }
    },
    "Text": {
      "Processing": {
        "MaximumLength": 102400
      }
    }
  },
  "Discussion": {
    "Pagination": {
      "DefaultPageSize": 25,
      "MaximumPageSize": 100
    },
    "Comments": {
      "Cache": {
        "ExpirationSeconds": 60
      }
    }
  }
}
