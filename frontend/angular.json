{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "forumish": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/forumish",
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "security": { "autoCsp": true },
              "optimization": { "styles": { "inlineCritical": false } },
              "budgets": [{ "type": "initial", "maximumWarning": "600kB", "maximumError": "900kB" }],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "proxyConfig": "proxy.conf.cjs" },
          "configurations": {
            "development": { "buildTarget": "forumish:build:development" },
            "production": { "buildTarget": "forumish:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
